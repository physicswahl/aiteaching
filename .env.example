# Environment Variables Template
# Copy this file to .env and fill in your values

# Django Settings
# Generate a new secret key for production: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=False

# Add your domain(s) separated by commas (no spaces)
# Example: ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (if using PostgreSQL in production)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Add any API keys or sensitive configuration here
